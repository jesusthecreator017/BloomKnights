# copy to .env — these match docker-compose.yml defaults (host port 5433)
DATABASE_URL=postgres://bloom:bloom@localhost:5433/bloomknights
TEST_DATABASE_URL=postgres://bloom:bloom@localhost:5433/bloomknights_test
BETTER_AUTH_SECRET=dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud key with "Maps JavaScript API" and "Places API" enabled,
# used by the Energy Explorer tab (src/components/explorer-map.tsx).
# Restrict it by HTTP referrer in the Google Cloud Console before sharing
# this app publicly — an unrestricted key can be used by anyone who copies
# it out of the bundle, and it's billed to your project.
VITE_GOOGLE_MAPS_API_KEY=

# Google AI Studio key (https://aistudio.google.com/apikey), used server-side
# by src/lib/gemini.ts to power AI quiz generation ("reshuffle" + "ask Gemini
# for a quiz" on /quiz). Without it, generation returns a clear 500 instead
# of erroring opaquely — everything else in the app works fine without it.
GEMINI_API_KEY= 

# Server-side Google Cloud key with "Places API (New)" enabled, used by
# src/lib/places.ts to power the address search on /explorer (Autocomplete
# (New) + Place Details (New)). Deliberately separate from
# VITE_GOOGLE_MAPS_API_KEY above: this one is never sent to the browser, so
# restrict it by IP address in Google Cloud Console rather than by referrer.
GOOGLE_PLACES_API_KEY= 
