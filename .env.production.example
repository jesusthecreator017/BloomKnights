# Copy to .env on the Pi (next to compose.prod.yml). Never commit the real .env.

# --- database (internal to the compose network; host is the service name `db`) ---
DATABASE_URL=postgres://bloom:bloom@db:5432/bloomknights
POSTGRES_USER=bloom
POSTGRES_PASSWORD=bloom
POSTGRES_DB=bloomknights

# --- auth ---
# generate a strong secret:  openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME
# your real public URL (the Cloudflare-fronted domain), no trailing slash
BETTER_AUTH_URL=https://bloomknights.tech

# --- cloudflare tunnel ---
# from Zero Trust > Networks > Tunnels > (your tunnel) > install token
TUNNEL_TOKEN=CHANGE_ME
